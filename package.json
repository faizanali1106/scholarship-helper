{
  "name": "scholarship-helper",
  "version": "1.0.0",
  "description": "Scholarship Helper — Chrome extension + local dashboard for scholarship applications",
  "type": "module",
  "scripts": {
    "start": "node launch.js",
    "launch": "node launch.js",
    "app": "node src/app-server.js",
    "apply": "node -e \"import('./src/apply/apply-worker.js').then(m=>m.runApply({mode:process.env.MODE||'fill'})).then(j=>console.log(JSON.stringify(j,null,2))).catch(e=>{console.error(e);process.exit(1)})\"",
    "scrape:fastweb": "node -e \"import('./src/scrapers/fastweb-sync.js').then(m=>m.runFastwebScrape({maxStates:3})).then(console.log).catch(e=>{console.error(e);process.exit(1)})\"",
    "scrape:niche": "node -e \"import('./src/scrapers/niche.js').then(m=>m.runNicheScrape({maxPages:3})).then(console.log).catch(e=>{console.error(e);process.exit(1)})\"",
    "scrape:diabetes": "node -e \"import('./src/scrapers/diabetes-scholars.js').then(m=>m.runDiabetesScholarsScrape()).then(console.log).catch(e=>{console.error(e);process.exit(1)})\"",
    "setup:scrapers": "npm install && cd fastweb && npm install && npx playwright install chromium",
    "vercel-build": "node scripts/vercel-build.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sparticuz/chromium": "^131.0.1",
    "cheerio": "^1.0.0-rc.12",
    "csv-parse": "^5.5.5",
    "csv-stringify": "^6.4.6",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "openai": "^4.77.0",
    "playwright": "^1.40.0",
    "playwright-core": "^1.48.2"
  }
}
